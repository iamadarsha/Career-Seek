# Career Seek — example environment configuration
# Copy to .env.local and fill in values. Most fields are optional.
# The app onboarding UI can also set API keys after first launch.
#
# Generated .env.local is .gitignored — it never leaves your machine.

# ─── AI Provider API Keys ─────────────────────────────────────────────────────
# Paste your key for whichever provider you use.
# You can also set these in Settings → AI Provider inside the app.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ─── AI Model Selection ───────────────────────────────────────────────────────
# Which provider to use by default (gemini | openai | anthropic | groq | deepseek | ollama | openai-compatible)
CAREER_SEEK_AI_PROVIDER=
# Override the default model per provider:
CAREER_SEEK_AI_MODEL=
CAREER_SEEK_GEMINI_MODEL=gemini-2.5-flash
CAREER_SEEK_OPENAI_MODEL=gpt-4o-mini
CAREER_SEEK_ANTHROPIC_MODEL=claude-3-5-sonnet-latest
CAREER_SEEK_GROQ_MODEL=llama-3.3-70b-versatile
CAREER_SEEK_GROQ_FALLBACK_MODELS=llama-3.1-8b-instant
CAREER_SEEK_DEEPSEEK_MODEL=deepseek-chat
CAREER_SEEK_OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
CAREER_SEEK_OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
# AI call settings
CAREER_SEEK_AI_MAX_ATTEMPTS=3
CAREER_SEEK_AI_TIMEOUT_MS=45000
JOBHUNT_RAG_MIN_RELEVANCE=18
CAREER_SEEK_ALLOW_MODEL_DOWNLOADS=0

# ─── Data Directory ───────────────────────────────────────────────────────────
# Where Career Seek stores your database, resumes, and generated documents.
# Defaults to ~/.jobhunt-india (macOS/Linux) or %USERPROFILE%\.jobhunt-india (Windows).
JOBHUNT_DATA_DIR=

# ─── Server / Launch Settings ─────────────────────────────────────────────────
CAREER_SEEK_PORT=3000
CAREER_SEEK_HOST=127.0.0.1
# Set to 1 for hot-reload development mode (slower startup)
CAREER_SEEK_DEV=0
# Set to 1 to skip the Next.js production build step (use when already built)
CAREER_SEEK_SKIP_BUILD=0
# Set to 1 to open the browser automatically after launch (default: 1)
CAREER_SEEK_OPEN_BROWSER=1

# ─── Bootstrap / Install Flags ───────────────────────────────────────────────
# Set to 1 to skip npm install during bootstrap (requires node_modules to exist)
CAREER_SEEK_SKIP_NPM_INSTALL=0
# Set to 1 to skip Playwright Chromium download (only needed for browser-backed scraping)
CAREER_SEEK_SKIP_BROWSER_INSTALL=0
# Set to 1 to skip Python venv + python-jobspy setup
CAREER_SEEK_SKIP_PYTHON_SETUP=0
# Set to 1 to skip starting Redis, Meilisearch, and Qdrant (use your own)
CAREER_SEEK_SKIP_NATIVE_SERVICES=0

# ─── Background Services ──────────────────────────────────────────────────────
# Redis: background job queue. Managed automatically by bootstrap.
REDIS_URL=redis://127.0.0.1:6379
# Bull Board: queue dashboard UI (optional — set CAREER_SEEK_ENABLE_BULL_BOARD=1 to start)
BULL_BOARD_PORT=3002
CAREER_SEEK_ENABLE_BULL_BOARD=0
# Browserless: optional headless browser service
BROWSERLESS_URL=http://127.0.0.1:3001
BROWSERLESS_WS_ENDPOINT=ws://127.0.0.1:3001
# Meilisearch: full-text search (managed automatically by bootstrap)
MEILI_HOST=http://127.0.0.1:7700
MEILISEARCH_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=
# Qdrant: vector search (managed automatically by bootstrap)
QDRANT_URL=http://127.0.0.1:6333
# Email notifications (optional — Mailpit for local testing)
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
CAREER_SEEK_EMAIL_FROM=Career Seek <career-seek@localhost>

# ─── Job Source Credentials (optional) ───────────────────────────────────────
# Setting these dramatically improves results by enabling authenticated scraping.
# LinkedIn: bypasses auth_gate and enables salary / advanced filters
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
# Naukri: enables full profile-based job recommendations
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# ─── Enhanced Source Connectors (optional) ───────────────────────────────────
# SerpAPI: bypasses Google CAPTCHA for Google Jobs discovery.
# Free tier: 100 searches/month — https://serpapi.com
SERPAPI_API_KEY=
