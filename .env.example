# Optional. You can also paste keys in the app onboarding/settings UI.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
CAREER_SEEK_AI_PROVIDER=
CAREER_SEEK_AI_MODEL=
CAREER_SEEK_GEMINI_MODEL=gemini-2.5-flash
CAREER_SEEK_OPENAI_MODEL=gpt-4o-mini
CAREER_SEEK_ANTHROPIC_MODEL=claude-3-5-sonnet-latest
CAREER_SEEK_GROQ_MODEL=llama-3.3-70b-versatile
CAREER_SEEK_GROQ_FALLBACK_MODELS=llama-3.1-8b-instant
CAREER_SEEK_DEEPSEEK_MODEL=deepseek-chat
CAREER_SEEK_OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
CAREER_SEEK_OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
CAREER_SEEK_AI_MAX_ATTEMPTS=3
CAREER_SEEK_AI_TIMEOUT_MS=45000
JOBHUNT_RAG_MIN_RELEVANCE=18
CAREER_SEEK_ALLOW_MODEL_DOWNLOADS=0

# Optional. Defaults to ~/.jobhunt-india on macOS/Linux and %USERPROFILE%\.jobhunt-india on Windows.
JOBHUNT_DATA_DIR=

# Optional launch overrides.
CAREER_SEEK_PORT=3000
CAREER_SEEK_HOST=127.0.0.1
CAREER_SEEK_DEV=0
CAREER_SEEK_SKIP_BUILD=0
CAREER_SEEK_SKIP_NPM_INSTALL=0
CAREER_SEEK_SKIP_BROWSER_INSTALL=0

# Local background queue and support services.
REDIS_URL=redis://127.0.0.1:6379
BULL_BOARD_PORT=3002
BROWSERLESS_URL=http://127.0.0.1:3001
BROWSERLESS_WS_ENDPOINT=ws://127.0.0.1:3001
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
CAREER_SEEK_EMAIL_FROM=Career Seek <career-seek@localhost>

# Optional enhanced source adapters.
# LinkedIn: set these to bypass auth_gate and scrape authenticated results.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
