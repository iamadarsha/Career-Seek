{
  "name": "jobhunt-india",
  "version": "1.0.0",
  "description": "Local-first AI-powered job search app",
  "main": "index.js",
  "engines": {
    "node": ">=20 <26"
  },
  "browserslist": [
    "defaults"
  ],
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/ensure-redis.mjs",
    "build": "next build",
    "start": "next start",
    "prestart": "node scripts/ensure-redis.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "audit:workbench": "node scripts/audit-action-workbench.mjs",
    "setup": "node scripts/bootstrap.mjs",
    "db:init": "node scripts/db-init.mjs",
    "db:generate": "drizzle-kit generate:sqlite",
    "db:push": "drizzle-kit push:sqlite",
    "db:push:direct": "node scripts/db-schema-push.mjs",
    "source:seed": "node scripts/seed-source-universe.mjs",
    "skills:build": "node scripts/skills/build-esco-lite.mjs",
    "k1:migrate": "node scripts/k1-bootstrap-migration.mjs",
    "doctor": "node scripts/doctor.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "launch": "node scripts/launch.mjs",
    "launch:dev": "node scripts/launch.mjs --dev",
    "launch:clean": "node scripts/clean-run.mjs",
    "docker:up": "node scripts/docker.mjs up",
    "docker:down": "node scripts/docker.mjs down",
    "docker:logs": "node scripts/docker.mjs logs",
    "docker:ps": "node scripts/docker.mjs ps",
    "worker": "npx tsx scripts/bull-worker.ts",
    "worker:legacy": "npx tsx scripts/job-worker.ts",
    "bull-board": "npx tsx scripts/bull-board.ts",
    "qa:queue": "npx tsx scripts/qa/queue-smoke.ts",
    "qa:scrapers": "npx tsx scripts/qa/scrapers-smoke.ts",
    "qa:ats": "npx tsx scripts/qa/phase3-ats-smoke.ts",
    "qa:phase4": "npx tsx scripts/qa/phase4-local-smoke.ts",
    "proof:final": "npx tsx scripts/final-proof-run.ts",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.72",
    "@ai-sdk/google": "^3.0.65",
    "@ai-sdk/openai": "^3.0.54",
    "@ai-sdk/openai-compatible": "^2.0.42",
    "@anthropic-ai/sdk": "^0.91.1",
    "@bull-board/api": "^7.0.0",
    "@bull-board/express": "^7.0.0",
    "@google/generative-ai": "^0.8.0",
    "@xenova/transformers": "^2.17.2",
    "ai": "^6.0.170",
    "ai-fallback": "^2.0.1",
    "better-sqlite3": "^11.0.0",
    "bullmq": "^5.76.4",
    "clsx": "^2.1.0",
    "docx": "^8.5.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.364.0",
    "mammoth": "^1.7.2",
    "next": "^14.2.35",
    "nodemailer": "^8.0.7",
    "ollama": "^0.6.3",
    "openai": "^6.35.0",
    "pdf-parse": "^1.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.43.1",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.2.2",
    "ts-jobspy": "^2.0.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
