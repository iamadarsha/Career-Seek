{
  "name": "jobhunt-india",
  "version": "1.0.0",
  "description": "Local-first AI-powered job search app",
  "main": "index.js",
  "browserslist": [
    "defaults"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:init": "node scripts/db-init.mjs",
    "db:generate": "drizzle-kit generate:sqlite",
    "db:push": "drizzle-kit push:sqlite",
    "db:push:direct": "node scripts/db-schema-push.mjs",
    "k1:migrate": "node scripts/k1-bootstrap-migration.mjs",
    "doctor": "node scripts/doctor.mjs",
    "launch": "node scripts/launch.mjs",
    "worker": "npx tsx scripts/job-worker.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.8.0",
    "better-sqlite3": "^11.0.0",
    "clsx": "^2.1.0",
    "docx": "^8.5.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.364.0",
    "mammoth": "^1.7.2",
    "next": "14.2.3",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.43.1",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.2.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "drizzle-kit": "^0.20.14",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}
